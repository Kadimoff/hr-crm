  personId            String
  person              Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  degree              AcademicDegreeType
  degreeName          String // şablondakı tam ad, məs. "İqtisad üzrə fəlsəfə doktoru"
  awardDate           DateTime           @db.Date
  field               String? // elmi fəaliyyət sahəsi
  dissertationCouncil String?
  diplomaSeriesNumber String?
  diplomaCode         String? // diplomun şifrəsi
  issuingInstitution  String?

  @@index([personId])
}

/// 8 Fiziki şəxsə aid məlumatlar.xlsx → Elmi adlar
model AcademicTitle {
  id                 String            @id @default(cuid())
  personId           String
  person             Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  title              AcademicTitleType
  titleName          String
  awardDate          DateTime          @db.Date
  direction          String? // elmi ad istiqaməti
  attestatSeries     String?
  diplomaNumber      String?
  issuingInstitution String?

  @@index([personId])
}

/// 8 Fiziki şəxsə aid məlumatlar.xlsx → Fəxri adlar, Dövlət təltifləri, Mükafatlar
model Award {
  id          String    @id @default(cuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind        AwardKind
  name        String
  awardDate   DateTime? @db.Date
  orderNumber String? // verilmə əmrinin nömrəsi
  issuedBy    String?

  @@index([personId])
}

/// 8 Fiziki şəxsə aid məlumatlar.xlsx → Partiya mənsubluğu
model PartyMembership {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  isMember      Boolean
  party         String?
  cardNumber    String?
  cardIssueDate DateTime? @db.Date

  @@index([personId])
}

/// 8 Fiziki şəxsə aid məlumatlar.xlsx → Seçki orqanlarında iştirakı
model ElectedOrgan {
  id          String    @id @default(cuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  location    String?
  organName   String
  position    String?
  electedDate DateTime? @db.Date
  exitDate    DateTime? @db.Date

  @@index([personId])
}

/// 8 Fiziki şəxsə aid məlumatlar.xlsx → Məhkəmə məsuliyyəti
model LegalLiability {
  id       String    @id @default(cuid())
  personId String
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  reason   String
  date     DateTime? @db.Date

  @@index([personId])
}

// ----------------------------------------------------------------------------
//  5. MƏZUNİYYƏT QALIQLARI VƏ HƏRƏKƏTLƏR
// ----------------------------------------------------------------------------

/// 3 Məzuniyyətlərin qalıqları.xlsx — 01.04.2025 tarixinə tam iş ili qalıqları (4 vərəq bir sətirdə birləşir)
model LeaveBalance {
  id             String   @id @default(cuid())
  personId       String
  person         Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  asOfDate       DateTime @db.Date
  periodStart    DateTime @db.Date
  periodEnd      DateTime @db.Date // = periodStart + 1 il - 1 gün
  basicDays      Decimal  @default(0) @db.Decimal(6, 2)
  seniorityDays  Decimal  @default(0) @db.Decimal(6, 2)
  hazardousDays  Decimal  @default(0) @db.Decimal(6, 2)
  motherhoodDays Decimal  @default(0) @db.Decimal(6, 2) // 14 yaşadək uşağı olan qadınlar

  @@unique([personId, periodStart])
}

/// 9 İşdə iştirak etməmə.xlsx
/// Əmr əsasında daxil edilən ödənişsiz məzuniyyət (dosyedə) — orderNumber doludur; idxal bu qeydlərə toxunmur.
/// Ləğv: qeyd silinmir, cancelledAt yazılır (staj, nişan, hesabat ləğv edilənləri nəzərə almır).
model Absence {
  id            String      @id @default(cuid())
  personId      String
  person        Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  type          AbsenceType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  orderNumber   String?
  orderDate     DateTime?   @db.Date
  note          String?
  createdById   String?
  createdBy     User?       @relation("AbsenceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?       @relation("AbsenceCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancelReason  String?

  @@index([personId, startDate])
}

// ----------------------------------------------------------------------------
//  6. İDXAL (ETL) MƏRHƏLƏLƏNDİRMƏ
// ----------------------------------------------------------------------------

model ImportBatch {
  id        String            @id @default(cuid())
  status    ImportBatchStatus @default(UPLOADED)
  createdBy String?
  creator   User?             @relation(fields: [createdBy], references: [id], onDelete: SetNull)
  files     ImportFile[]
  rows      StagingRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ImportFile {
  id            String           @id @default(cuid())
  batchId       String
  batch         ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  templateKey   String // "kadr", "family", "leave", ...
  fileName      String
  storagePath   String
  status        ImportFileStatus @default(QUEUED)
  totalRows     Int              @default(0)
  validRows     Int              @default(0)
  invalidRows   Int              @default(0)
  committedRows Int              @default(0)
  /// Struktur xətaları (başlıq uyğunsuzluğu, çatışmayan vərəq)
  fileErrors    Json             @default("[]") @db.JsonB
  rows          StagingRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
}

model StagingRow {
  id        String           @id @default(cuid())
  batchId   String
  batch     ImportBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileId    String
  file      ImportFile       @relation(fields: [fileId], references: [id], onDelete: Cascade)
  stage     ImportStage
  sheetKey  String // "persons", "positions", "departments2", ...
  rowNumber Int
  /// Xam hüceyrə dəyərləri (sütun açarı → mətn)
  data      Json             @db.JsonB
  /// [{ field, tier: "syntactic"|"semantic"|"reference", message }]
  errors    Json             @default("[]") @db.JsonB
  status    StagingRowStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fileId, sheetKey, rowNumber])
  @@index([batchId, stage, status])
}

// ----------------------------------------------------------------------------
//  7. İSTİFADƏÇİLƏR, SESSİYALAR, AUDİT JURNALI
// ----------------------------------------------------------------------------

enum UserRole {
  ROOT // sistem administratoru — istifadəçilər və audit jurnalı
  HR // kadr əməkdaşı — əməkdaşların əlavəsi, redaktəsi, idxal
  DEPT_HEAD // şöbə rəhbəri — yalnız öz bölməsinin (alt bölmələr daxil) əməkdaşlarına baxış
}

model User {
  id                        String      @id @default(cuid())
  username                  String      @unique // kiçik hərflə saxlanılır
  fullName                  String
  passwordHash              String
  role                      UserRole
  departmentId              String? // DEPT_HEAD üçün məcburi
  department                Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive                  Boolean     @default(true)
  /// Şəxsi iş sənədlərini sorğusuz silə bilər (ROOT həmişə silir) — root verir
  canDeleteDocuments        Boolean     @default(false)
  /// true — növbəti girişdə şifrəni dəyişməlidir (root yaradanda / sıfırlayanda); o vaxta qədər yalnız şifrə dəyişmə səhifəsi açılır
  mustChangePassword        Boolean     @default(false)
  /// Hesabın sahibi olan əməkdaş (root bağlayır). Bağlı şəxs öz maaşını görür (dəyişə bilmir), digər HR-lar görmür.
  /// @unique əvəzinə tətbiq səviyyəsində unikal — canlıda `db push` unikal indeks xəbərdarlığı ilə dayanmasın
  personId                  String?
  person                    Person?     @relation("UserPerson", fields: [personId], references: [id], onDelete: SetNull)
  /// Məxfi maaşları görə və dəyişə bilər (root verir — məs. kadr şöbəsinin müdiri). Default false
  canViewRestrictedSalaries Boolean     @default(false)
  /// Əsasnamə və vəzifə təlimatlarını təsdiq edə bilər («charter.approve»; ROOT həmişə). Default false
  canApproveCharters        Boolean     @default(false)
  passwordChangedAt         DateTime?
  lastLoginAt               DateTime?
  createdById               String?
  createdBy                 User?       @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers              User[]      @relation("UserCreatedBy")

  sessions          Session[]
  auditLogs         AuditLog[]
  personsCreated    Person[]                  @relation("PersonCreatedBy")
  personsUpdated    Person[]                  @relation("PersonUpdatedBy")
  personsDeleted    Person[]                  @relation("PersonDeletedBy")
  importBatches     ImportBatch[]
  documents         PersonDocument[]
  deletionRequests  DocumentDeletionRequest[] @relation("DeletionRequestedBy")
  deletionDecisions DocumentDeletionRequest[] @relation("DeletionDecidedBy")
  movementsCreated  EmploymentMovement[]      @relation("MovementCreatedBy")
  financialChanges  FinancialChange[]         @relation("FinancialChangeCreatedBy")
  absencesCreated   Absence[]                 @relation("AbsenceCreatedBy")
  absencesCancelled Absence[]                 @relation("AbsenceCancelledBy")
  departmentChanges DepartmentChange[]        @relation("DepartmentChangeCreatedBy")
  chartersCreated   DepartmentCharter[]       @relation("CharterCreatedBy")
  chartersApproved  DepartmentCharter[]       @relation("CharterApprovedBy")
  jobDescsCreated   JobDescription[]          @relation("JobDescriptionCreatedBy")
  jobDescsApproved  JobDescription[]          @relation("JobDescriptionApprovedBy")
  jobDescAcks       JobDescriptionAck[]       @relation("JobDescriptionAckBy")
  documentsVerified PersonDocument[]          @relation("DocumentVerifiedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
}

model Session {
  id        String   @id // tokenin SHA-256 heşi — tokenin özü yalnız cookie-də
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CREATE
  UPDATE
  DELETE
  RESTORE
  IMPORT
  EXPORT
  PRINT
  PASSWORD_RESET
  PASSWORD_CHANGE // istifadəçi öz şifrəsini dəyişdi
}

/// Dəyişməz jurnal — yalnız əlavə olunur
model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  username  String? // istifadəçi silinsə/adı dəyişsə də jurnalda qalsın
  action    AuditAction
  entity    String // "Person", "User", "ImportBatch", "Report", "Session"
  entityId  String?
  summary   String
  /// UPDATE üçün: { sahə: [əvvəl, sonra] }; CREATE/DELETE üçün qeydin snapshot-u
  changes   Json?       @db.JsonB
  ip        String?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}
