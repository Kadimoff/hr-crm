  @@index([personId])
}

/// 6 Digər məlumatlar.xlsx → Əməkdaşın əsərləri
model Publication {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  title         String
  publishedDate DateTime? @db.Date
  topic         String?
