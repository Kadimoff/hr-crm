// ============================================================================
//  ASOİU HR CRM — Kadr və Əməkhaqqı İdarəetmə Sistemi
//  PostgreSQL 16+ · Prisma ORM
//
//  Bölmələr:
//    1. Təşkilati struktur (Struktur bölmələri, Vəzifələr, Ştat cədvəli)
//    2. Fiziki şəxslər və əmək müqavilələri
//    3. Paralel profillər (əmək fəaliyyəti, hərbi uçot, əlillik, ailə)
//    4. Akademik portfolio (fayl 6, 7, 8)
//    5. Məzuniyyət qalıqları və hərəkətlər (fayl 3, 9, 10)
//    6. İdxal (ETL) mərhələləndirmə cədvəlləri
//    7. İstifadəçilər, sessiyalar və audit jurnalı
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
//  ENUMS
// ----------------------------------------------------------------------------

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum PositionCategory {
  QULLUQCU // qulluqçu
  FEHLE // fəhlə
}

enum StaffCategory {
  INZIBATI // İnzibati heyət
  PROFESSOR_MUELLIM // Professor-müəllim heyəti
  TEDRIS_KOMEKCI // Tədris-köməkçi heyət
  XIDMETEDICI // Xidmətedici heyət
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

enum DisabilityGroup {
  GROUP_1
  GROUP_2
  GROUP_3
  CHILD_UNDER_18 // 18 yaşadək sağlamlıq imkanları məhdud uşaq
}

/// 9 İşdə iştirak etməmə.xlsx — 3 vərəq
enum AbsenceType {
  SICK // xəstəlik
  UNKNOWN // naməlum səbəb
  SOCIAL_PAID // sm — (qismən) ödənişli sosial məzuniyyət
  SOCIAL_UNPAID // ö/sm — ödənişsiz sosial məzuniyyət
  UNPAID // ö/m — ödənişsiz məzuniyyət
}

/// Kadr hərəkətinin növü (əmrdə göstərilən). Köhnə qeydlərdə null — göstərmədə from/to-ya əsasən təxmini növ
enum MovementKind {
  TRANSFER // köçürmə (bölmə və / və ya vəzifə)
  PROMOTION // vəzifə artımı
  SALARY_CHANGE // maaş (oklad) dəyişikliyi
  UNIT_CHANGE // ştat payı dəyişikliyi
}

/// Maliyyə tarixçəsində izlənən, əməkhaqqına təsir edən sahələr
enum FinanceField {
  BASE_SALARY // oklad
  UNIT_SHARE // ştat payı
  PAYMENT_FORM // ödəniş forması
  POSITION // vəzifə (zərərli şərait əlavəsi vəzifədən gəlir)
  DEPARTMENT // struktur bölmə
  HAZARDOUS_PCT // ağır / zərərli şəraitə görə əlavə, %
  TAX_EXEMPTION // VM 102.2 vergi güzəşti (şəxs səviyyəli)
  DEGREE // elmi dərəcə (şəxs səviyyəli)
  TITLE // elmi ad (şəxs səviyyəli)
}

/// Dəyişikliyin hansı yolla edildiyi
enum FinanceSource {
  MOVEMENT // dosyedə «Kadr hərəkəti» forması (əmr)
  EDIT // tam redaktə forması
  QUICK_EDIT // struktur xəritəsində sürətli redaktə
  IMPORT // Excel idxalı
}

enum AcademicDegreeType {
  PHD // Fəlsəfə doktoru
  DSC // Elmlər doktoru
}

enum AcademicTitleType {
  DOCENT
  PROFESSOR
  CORRESPONDING_MEMBER // AMEA müxbir üzvü
  ACADEMICIAN // AMEA həqiqi üzvü
}

enum AwardKind {
  HONORARY_TITLE // Fəxri ad
  STATE_AWARD // Dövlət təltifi
  PRIZE // Mükafat
}

enum SkillKind {
  GENERAL
  SOFTWARE
}

/// Bilmə səviyyəsi: əla / yaxşı / kafi
enum Proficiency {
  EXCELLENT
  GOOD
  SATISFACTORY
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATING
  READY // xətasız, commit-ə hazır
  NEEDS_REVIEW
  COMMITTING
  COMPLETED
  FAILED
}

enum ImportFileStatus {
  QUEUED
  PARSING
  VALIDATED
  HAS_ERRORS
  COMMITTED
  FAILED
}

enum StagingRowStatus {
  PENDING
  VALID
  INVALID
  COMMITTED
}

/// Topoloji idxal ardıcıllığı — dəyər sırası icra sırasıdır.
enum ImportStage {
  S1_DEPARTMENTS
  S2_POSITIONS
  S3_STAFFING
  S4_PERSONS
  S5_EMPLOYMENTS
  S6_PROFILES
  S7_LEAVE_BALANCES
  S8_MOVEMENTS
}

// ----------------------------------------------------------------------------
//  1. TƏŞKİLATİ STRUKTUR
// ----------------------------------------------------------------------------

/// Struktur düyününün növü (TZ M01) — null: köhnə qeyd (isFaculty / isChair-dən təxmin edilir)
enum DepartmentKind {
  KURATOR_BLOKU // prorektor / kurator bloku
  DEPARTAMENT
  SOBE // şöbə
  BOLME // bölmə
  SEKTOR
  MERKEZ // mərkəz
  LABORATORIYA
  TEDQIQAT_QRUPU
  FAKULTE
  KAFEDRA
  XIDMET
  INSTITUT
  KOLLEC
  BINA
  MUZEY
  SURA // kollegial orqan
  DIGER
}

/// 5 Struktur bölmələri.xlsx — 6 səviyyəyədək ağac
model Department {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  level     Int // 1..6
  isFaculty Boolean      @default(false)
  isChair   Boolean      @default(false) // kafedra
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Department[] @relation("DepartmentTree")
  createdOn DateTime     @db.Date
  closedOn  DateTime?    @db.Date

  staffingUnits    StaffingUnit[]
  employments      Employment[]
  heads            User[] // şöbə rəhbərləri (DEPT_HEAD rolu)
  /// Maaşlar məxfidir: bu bölmədə və alt bölmələrində müqaviləsi olan (və olmuş) şəxslərin maaşını yalnız root
  /// və «məxfi maaşları görə bilər» hesabları görür/dəyişir (root qoşur). Default false — heç nə dəyişmir.
  salaryRestricted Boolean        @default(false)

  /// Düyünün növü (Departament, Şöbə, Fakültə, …); null — köhnə qeyd
  kind              DepartmentKind?
  /// Eyni valideyn daxilində sıra (təsdiqlənmiş sxemdəki ardıcıllıq); null — koda görə
  sortOrder         Int?
  /// Ayrıca hüquqi şəxs (institut, kollec, UFAZ) — hesabat cəmlərində ayrıca göstərilir
  isExternal        Boolean             @default(false)
  /// Ştatsız qrup / kollegial düyün (Şura, prorektorlar qrupu) — ştat və vakansiya sayılmır
  isGroup           Boolean             @default(false)
  /// Rəhbərin vəzifəsi (məs. «Prorektor (tədris üzrə)»)
  headPositionTitle String?
  campus            String?
  budgetCenter      String?
  changes           DepartmentChange[]
  charters          DepartmentCharter[]
  jobDescriptions   JobDescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([level])
}

enum DepartmentChangeKind {
  CREATE // yaradılma
  RENAME // adın dəyişdirilməsi
  MOVE // tabeliyin dəyişdirilməsi
  CLOSE // bağlanma (ləğv)
  MERGE // başqa bölmə ilə birləşmə (bölmə bağlanır, hədəf bölmə qalır)
}

/// Struktur dəyişikliklərinin tarixçəsi (TZ M01-01, DAT-01). before / after: { name, parentId, closedOn, … }.
/// effectiveDate > bu gün — planlaşdırılmış dəyişiklik: appliedAt null qalır, cari struktur dəyişmir; tarix çatanda
/// tətbiq olunur (worker-in gündəlik işi və struktur səhifəsinin açılışı). «Tarixə görə struktur» buradan bərpa olunur.
model DepartmentChange {
  id                 String               @id @default(cuid())
  departmentId       String
  department         Department           @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  kind               DepartmentChangeKind
  effectiveDate      DateTime             @db.Date
  orderNumber        String?
  orderDate          DateTime?            @db.Date
  before             Json?                @db.JsonB
  after              Json?                @db.JsonB
  /// MERGE: birləşdiyi (qalan) bölmə
  targetDepartmentId String?
  note               String?
  /// UI | IMPORT | SYSTEM
  source             String               @default("UI")
  /// Bölməyə tətbiq olunma anı; null — planlaşdırılıb (gələcək tarix) və ya ləğv edilib
  appliedAt          DateTime?
  cancelledAt        DateTime?
  createdById        String?
  createdBy          User?                @relation("DepartmentChangeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt          DateTime             @default(now())

  @@index([departmentId, effectiveDate])
  @@index([effectiveDate, appliedAt])
}

/// Əsasnamə və vəzifə təlimatının həyat dövrü (TZ M01-02, M03-02)
enum RegulationStatus {
  QARALAMA // hazırlanır
  HUQUQI_REYDE // hüquqi rəydə
  TESDIQLENIB // təsdiqlənib (qüvvədədir) — mətn və fayl dəyişdirilmir
  QUVVEDEN_DUSUB // yeni versiya ilə əvəzlənib / ləğv edilib
}

/// Struktur bölməsinin əsasnaməsi — versiyalı. Təsdiqlənmiş versiya dəyişdirilmir (server), yenisi yaradılır.
model DepartmentCharter {
  id               String           @id @default(cuid())
  departmentId     String
  department       Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  version          Int
  status           RegulationStatus @default(QARALAMA)
  title            String
  purpose          String?
  functions        String?
  authorities      String?
  responsibilities String?
  reportingLine    String?
  approvedOn       DateTime?        @db.Date
  /// Təsdiq edən (mətn, məs. «Rektor»)
  approvedBy       String?
  orderNumber      String?
  effectiveFrom    DateTime?        @db.Date
  effectiveTo      DateTime?        @db.Date
  nextReviewOn     DateTime?        @db.Date
  legalReviewText  String?
  legalReviewDate  DateTime?        @db.Date
  legalReviewBy    String?
  /// İmzalı fayl (PDF) — DOCUMENTS_DIR/_org/charters/<id>.<uzantı>
  fileName         String?
  fileExtension    String?
  fileSize         Int?
  fileStoragePath  String?
  createdById      String?
  createdBy        User?            @relation("CharterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedByUser   User?            @relation("CharterApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([departmentId, version])
  @@index([status, nextReviewOn])
}

/// TZ §3 təsnifatı: A1 akademik tədris, A2 elmi tədqiqat, N1–N5 qeyri-akademik qruplar
enum PositionClass {
  A1
  A2
  N1
  N2
  N3
  N4
  N5
}

/// 1 Kadr Cədvəlləri.xlsx → Vəzifələr
model Position {
  id                         String           @id @default(cuid())
  code                       String           @unique
  name                       String           @unique // vəzifələrin adları təkrarlana bilməz
  category                   PositionCategory
  staffCategory              StaffCategory
  basicLeaveDays             Int // 21 / 30 / 42 / 48 / 56
  hazardousLeaveDays         Int              @default(0)
  hazardousAllowancePct      Decimal?         @db.Decimal(5, 2) // ağır/zərərli şəraitə görə əlavə, %
  isPedagogical              Boolean          @default(false) // pedaqoji heyət
  isScientific               Boolean          @default(false) // elmi staj
  isScientificPedagogical    Boolean          @default(false) // elmi-pedaqoji staj
  isAdministrativeManagement Boolean          @default(false) // inzibati idarəetmə personalı
  validFrom                  DateTime         @db.Date // vəzifənin yaradılma tarixi
  validTo                    DateTime?        @db.Date // vəzifənin bağlanma tarixi
  /// Peşə ailəsi (TZ M03-01), məs. «Maliyyə», «İT»
  jobFamily                  String?
  /// TZ §3 idarəetmə təsnifatı (staffCategory — rəsmi statistik kateqoriya, ayrıca saxlanılır)
  classCode                  PositionClass?
  /// Grade (gələcək M11 üçün), məs. «G5»
  gradeCode                  String?

  staffingUnits   StaffingUnit[]
  employments     Employment[]
  jobDescriptions JobDescription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffCategory])
}

/// 4 Ştat cədvəli.xlsx — dövr üzrə ştat vahidləri
model StaffingUnit {
  id           String     @id @default(cuid())
  periodDate   DateTime   @db.Date
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  positionId   String
  position     Position   @relation(fields: [positionId], references: [id], onDelete: Restrict)
  unitCount    Decimal    @db.Decimal(6, 2) // 0.25, 0.5, 1.0 ...
  minSalary    Decimal    @db.Decimal(12, 2)
  maxSalary    Decimal    @db.Decimal(12, 2)
  salaryType   String? // maaşın növü
  schedule     String // iş rejimi / iş qrafiki

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodDate, departmentId, positionId])
  @@index([departmentId])
  @@index([positionId])
}

// ----------------------------------------------------------------------------
//  2. FİZİKİ ŞƏXSLƏR VƏ ƏMƏK MÜQAVİLƏLƏRİ
// ----------------------------------------------------------------------------

/// 1 Kadr Cədvəlləri.xlsx → Fiziki şəxslər
model Person {
  id            String         @id @default(cuid())
  code          String         @unique // əməkdaş kodu
  fullName      String // "Soyadı Adı Atasının adı" — axtarış üçün
  lastName      String
  firstName     String
  patronymic    String?
  gender        Gender
  birthDate     DateTime       @db.Date
  maritalStatus MaritalStatus?

  // Əlaqə
  mobilePhone       String?
  workPhone         String? // xidməti telefon
  email             String?
  registeredAddress String?
  livingAddress     String?

  // Sosial sığorta
  ssn String? @unique // Sosial sığorta şəhadətnaməsinin nömrəsi

  // Doğum yeri
  birthCountry  String?
  birthDistrict String?
  birthCity     String?

  // Şəxsiyyəti təsdiq edən sənəd
  idDocType      String // Şəxsiyyət vəsiqəsi, pasport, ...
  idDocSeries    String?
  idDocNumber    String
  idDocIssueDate DateTime? @db.Date
  idDocIssuedBy  String?
  fin            String    @unique @db.Char(7) // FİN kod — 7 simvol

  // İşə qəbul tarixinə olan staj (il / ay / gün)
  laborSeniorityYears                  Int @default(0)
  laborSeniorityMonths                 Int @default(0)
  laborSeniorityDays                   Int @default(0)
  scientificSeniorityYears             Int @default(0)
  scientificSeniorityMonths            Int @default(0)
  scientificSeniorityDays              Int @default(0)
  scientificPedagogicalSeniorityYears  Int @default(0)
  scientificPedagogicalSeniorityMonths Int @default(0)
  scientificPedagogicalSeniorityDays   Int @default(0)
  unecSeniorityYears                   Int @default(0)
  unecSeniorityMonths                  Int @default(0)
  unecSeniorityDays                    Int @default(0)
  insuranceSeniorityYears              Int @default(0)
  insuranceSeniorityMonths             Int @default(0)
  insuranceSeniorityDays               Int @default(0)

  // Vergi güzəşti (Vergi Məcəlləsi 102-ci maddə bəndi, məs. "102.2.1")
  taxExemptionClause String?

  citizenship  String?
  nationality  String?
  socialOrigin String?

  // Əcnəbi məlumatları
  isForeigner       Boolean   @default(false)
  visaNumber        String?
  visaIssueDate     DateTime? @db.Date
  visaExpiryDate    DateTime? @db.Date
  passportNumber    String? // pasportun seriya və nömrəsi
  passportIssueDate DateTime? @db.Date
  passportExpiry    DateTime? @db.Date
  arrivalDate       DateTime? @db.Date

  isIdpOrRefugee      Boolean @default(false) // məcburi köçkün
  /// Kvota üzrə qəbul edilmiş və əsas məzuniyyəti 21/30-dan fərqli olanlar üçün — vəzifənin əsas məzuniyyətini ƏVƏZ edir
  quotaBasicLeaveDays Int?

  /// Şablonlardan kənar sahələr üçün genişlənmə
  extensions Json @default("{}") @db.JsonB

  employments       Employment[]
  workHistory       WorkHistory[]
  militaryRecord    MilitaryRecord?
  disabilities      Disability[]
  familyMembers     FamilyMember[]
  leaveBalances     LeaveBalance[]
  absences          Absence[]
  intellectualProps IntellectualProperty[]
  projects          Project[]
  events            ScientificEvent[]
  publications      Publication[]
  attestations      Attestation[]
  researchTopics    ResearchTopic[]
  languages         LanguageProficiency[]
  educations        Education[]
  skills            Skill[]
  academicDegrees   AcademicDegree[]
  academicTitles    AcademicTitle[]
  awards            Award[]
  partyMemberships  PartyMembership[]
  electedOrgans     ElectedOrgan[]
  legalLiabilities  LegalLiability[]
  documents         PersonDocument[]
  financialChanges  FinancialChange[]

  /// Maaş məxfiliyi şəxs səviyyəsində (bölmədən asılı olmayaraq) — root qoyur. Default false
  salaryRestricted Boolean @default(false)
  /// Bu şəxsə bağlanmış istifadəçi hesabları (tətbiq səviyyəsində ən çox bir) — bağlı şəxsin maaşı avtomatik məxfidir
  userAccounts     User[]  @relation("UserPerson")

  // Qeydiyyat və arxiv (soft delete) — kim, nə vaxt
  createdById String?
  createdBy   User?     @relation("PersonCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("PersonUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("PersonDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([deletedAt])
}

/// 1 Kadr Cədvəlləri.xlsx → Əməkdaşlar
model Employment {
  id           String           @id @default(cuid())
  personId     String
  person       Person           @relation(fields: [personId], references: [id], onDelete: Cascade)
  positionId   String
  position     Position         @relation(fields: [positionId], references: [id], onDelete: Restrict)
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  hireDate     DateTime         @db.Date
  schedule     String // iş rejimi / iş qrafiki
  paymentForm  String // ödəniş forması (şablondakı mətn)
  baseSalary   Decimal          @db.Decimal(12, 2) // oklad
  unitShare    Decimal          @default(1) @db.Decimal(4, 2) // tutduğu ştat vahidi
  isPrimary    Boolean          @default(true) // əsas iş yeri / əvəzçilik
  status       EmploymentStatus @default(ACTIVE)

  // 10 İşdən azad olunmuş əməkdaşlar.xlsx
  terminationDate    DateTime? @db.Date
  terminationArticle String? // AR ƏM maddəsi

  /// Müqavilənin növü (TZ M05-02/03); null — qeyd edilməyib
  contractType     ContractType?
  /// Müddətli müqavilənin bitmə tarixi — 90/60/30 günlük bildirişlər
  contractEndDate  DateTime?     @db.Date
  /// Müqavilə sonu üzrə məsul şəxs və sonrakı qərar (sadə mətn)
  contractEndOwner String?
  contractEndNote  String?

  salaryHistory      SalaryRecord[]
  movements          EmploymentMovement[]
  financialChanges   FinancialChange[]
  jobDescriptionAcks JobDescriptionAck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, positionId, departmentId, hireDate])
  @@index([departmentId, status])
  @@index([positionId, status])
}

enum ContractType {
  MUDDETLI // müddətli
  MUDDETSIZ // müddətsiz
}

enum DocumentKind {
  EMR // əmr
  MUQAVILE // əmək müqaviləsi və əlavələri
  SEXSIYYET // şəxsiyyət vəsiqəsi, FİN, ünvan
  TEHSIL // diplom, sertifikat, elmi dərəcə
  ARAYIS // arayış, tibbi sənəd
  DIGER // digər
  HERBI // hərbi bilet
  SOSIAL_STATUS // sosial status sənədləri
  VEZIFE_TELIMATI_TANISLIQ // vəzifə təlimatı ilə tanışlıq vərəqəsi
  ATTESTASIYA
  ELMI_DERECE // elmi dərəcə / ad diplomları
}

/// Vəzifə təlimatı — versiyalı (TZ M03-02). departmentId null — vəzifə üzrə ümumi təlimat; verilibsə həmin bölmə üçün.
model JobDescription {
  id               String              @id @default(cuid())
  positionId       String
  position         Position            @relation(fields: [positionId], references: [id], onDelete: Restrict)
  departmentId     String?
  department       Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  version          Int
  status           RegulationStatus    @default(QARALAMA)
  title            String
  purpose          String?
  duties           String?
  rights           String?
  responsibilities String?
  reportsTo        String?
  competencies     String?
  educationReq     String?
  experienceReq    String?
  approvedOn       DateTime?           @db.Date
  approvedBy       String?
  orderNumber      String?
  effectiveFrom    DateTime?           @db.Date
  effectiveTo      DateTime?           @db.Date
  legalReviewText  String?
  legalReviewDate  DateTime?           @db.Date
  legalReviewBy    String?
  fileName         String?
  fileExtension    String?
  fileSize         Int?
  fileStoragePath  String?
  createdById      String?
  createdBy        User?               @relation("JobDescriptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedById     String?
  approvedByUser   User?               @relation("JobDescriptionApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  acks             JobDescriptionAck[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@index([positionId, departmentId, version])
  @@index([status])
}

/// Vəzifə təlimatı ilə tanışlıq tapşırığı / qeydi. Yeni versiya təsdiqlənəndə yenisi yaranır, köhnələr silinmir.
/// acknowledgedAt — əməkdaşın tanış olduğu (kağızda imzaladığı) tarix; acknowledgedBy — qeyd edən HR.
model JobDescriptionAck {
  id               String         @id @default(cuid())
  jobDescriptionId String
  jobDescription   JobDescription @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  employmentId     String
  employment       Employment     @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  /// Tapşırığın səbəbi: «Yeni versiya», «İşə qəbul», «Köçürmə»
  reason           String?
  assignedAt       DateTime       @default(now())
  acknowledgedAt   DateTime?      @db.Date
  acknowledgedById String?
  acknowledgedBy   User?          @relation("JobDescriptionAckBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  note             String?

  @@unique([jobDescriptionId, employmentId])
  @@index([employmentId])
  @@index([acknowledgedAt])
}

/// «Şəxsi iş» qovluğu: əmrlər, skan edilmiş sənədlər, şəkillər, Word/Excel faylları.
/// Fayl diskdə saxlanılır (DOCUMENTS_DIR/<personId>/<id>.<uzantı>), burada yalnız məlumatı.
model PersonDocument {
  id               String                    @id @default(cuid())
  personId         String
  person           Person                    @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind             DocumentKind
  title            String
  number           String? // əmrin / sənədin nömrəsi
  documentDate     DateTime?                 @db.Date // əmrin / sənədin tarixi
  fileName         String // yüklənən faylın orijinal adı
  extension        String // kiçik hərflə, nöqtəsiz: pdf, jpg, docx ...
  size             Int
  storagePath      String
  uploadedById     String?
  uploadedBy       User?                     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  deletionRequests DocumentDeletionRequest[]
  /// «Yoxlanılıb» işarəsi (TZ M05-01): sənədin əsli ilə tutuşdurulub — kim, nə vaxt
  verifiedAt       DateTime?
  verifiedById     String?
  verifiedBy       User?                     @relation("DocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([personId, kind])
}

enum DeletionRequestStatus {
  PENDING // root-un qərarını gözləyir
  APPROVED // təsdiq edildi, sənəd silindi
  REJECTED // imtina edildi, sənəd qalır
}

/// Sənədi birbaşa silə bilməyən istifadəçinin root-a silmə sorğusu.
/// Sənəd silinəndən sonra da tarixçə qalsın deyə adlar snapshot kimi saxlanılır.
model DocumentDeletionRequest {
  id            String                @id @default(cuid())
  documentId    String?
  document      PersonDocument?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  personId      String
  personName    String
  documentTitle String
  fileName      String
  reason        String
  status        DeletionRequestStatus @default(PENDING)
  requestedById String?
  requestedBy   User?                 @relation("DeletionRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?                 @relation("DeletionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([documentId])
}

/// Oklad dəyişikliklərinin temporal tarixçəsi
model SalaryRecord {
  id           String     @id @default(cuid())
  employmentId String
  employment   Employment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  baseSalary   Decimal    @db.Decimal(12, 2)
  validFrom    DateTime   @db.Date
  validTo      DateTime?  @db.Date

  @@index([employmentId, validFrom])
}

/// Kadr hərəkəti — əmr əsasında köçürmə (bölmə / vəzifə), oklad və ya ştat payı dəyişikliyi.
/// Müqavilənin özü yeni vəziyyətə yenilənir, bu cədvəl isə «nə idi → nə oldu» tarixçəsini saxlayır
/// (Hərəkət hesabatı buradan oxuyur). null — həmin sahə dəyişməyib. Adlar snapshot kimi saxlanılır:
/// bölmə / vəzifə sonradan adını dəyişsə və ya bağlansa da tarixçə oxunaqlı qalır.
model EmploymentMovement {
  id               String        @id @default(cuid())
  employmentId     String
  employment       Employment    @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  orderNumber      String // əmrin nömrəsi
  orderDate        DateTime      @db.Date // əmrin tarixi
  effectiveDate    DateTime      @db.Date // qüvvəyə minmə tarixi
  /// Əmrdə göstərilən növ; null — köhnə qeyd (növ from/to-ya əsasən təxmin edilir)
  kind             MovementKind?
  fromDepartmentId String?
  fromDepartment   String?
  toDepartmentId   String?
  toDepartment     String?
  fromPositionId   String?
  fromPosition     String?
  toPositionId     String?
  toPosition       String?
  fromSalary       Decimal?      @db.Decimal(12, 2)
  toSalary         Decimal?      @db.Decimal(12, 2)
  fromUnitShare    Decimal?      @db.Decimal(4, 2)
  toUnitShare      Decimal?      @db.Decimal(4, 2)
  note             String?
  createdById      String?
  createdBy        User?         @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  financialChanges FinancialChange[]

  createdAt DateTime @default(now())

  @@index([employmentId, effectiveDate])
  @@index([effectiveDate])
}

/// Maliyyə tarixçəsi — əməkhaqqına təsir edən sahənin hər dəyişikliyi (köhnə → yeni), hansı yoldan edilirsə edilsin
/// (hərəkət forması, tam forma, sürətli redaktə, idxal). «Tarixə görə baxış» cari vəziyyətdən başlayıb qüvvəyə minmə
/// tarixi seçilmiş tarixdən sonra olan dəyişiklikləri geri açır. value — maşın dəyəri (rəqəm, id, mətn), label — oxunaqlı ad.
/// Bu cədvəldən əvvəlki tarixçə oxuma zamanı EmploymentMovement və SalaryRecord-dan bərpa olunur.
model FinancialChange {
  id            String              @id @default(cuid())
  personId      String
  person        Person              @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// null — şəxs səviyyəli sahə (vergi güzəşti, elmi dərəcə / ad)
  employmentId  String?
  employment    Employment?         @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  field         FinanceField
  oldValue      String?
  newValue      String?
  oldLabel      String?
  newLabel      String?
  effectiveDate DateTime            @db.Date
  source        FinanceSource
  orderNumber   String?
  orderDate     DateTime?           @db.Date
  movementId    String?
  movement      EmploymentMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?               @relation("FinancialChangeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([personId, effectiveDate])
  @@index([employmentId, effectiveDate])
  @@index([movementId])
}

